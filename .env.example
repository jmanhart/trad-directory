# Required — Supabase. The app throws on startup if these are missing.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional — Sentry error monitoring. Falls back to a shared DSN if unset.
VITE_SENTRY_DSN=

# Optional — admin area password. Defaults to "admin123" in dev.
VITE_ADMIN_PASSWORD=

# Optional — override the API base URL. Defaults to /api; set this when
# running `vercel dev` on a different port (see `npm run dev:admin`).
VITE_API_URL=
