{
  "installCommand": "npm install --include=dev",
  "framework": "vite",
  "functions": {
    "api/render.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Document-Policy",
          "value": "js-profiling"
        }
      ]
    }
  ],
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "env": {
    "NPM_CONFIG_PRODUCTION": "false"
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": true
    }
  },
  "crons": [
    {
      "path": "/api/checkInstagramLinks",
      "schedule": "0 2-5 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 7 * * 0"
    }
  ]
}